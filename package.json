{
  "name": "attendora-monorepo",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm --prefix frontend install && npm --prefix backend install",
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:backend:flask": "python backend/app.py",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "test:frontend": "node --experimental-strip-types --test frontend/src/utils/*.test.ts frontend/src/api/*.test.ts",
    "test:backend": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test": "npm run test:frontend && npm run test:backend"
  }
}
