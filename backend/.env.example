# Attendora Enterprise Backend Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# Security & JWT Tokens
JWT_SECRET=attendora-jwt-secure-signing-key-minimum-256-bit
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Supabase Cloud Database Integration
# Direct connection: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
DATABASE_URL=postgresql://attendora_user:attendora_pass@localhost:5432/attendora_db
REDIS_URL=redis://localhost:6379/0

# Statutory UGC Thresholds
DEFAULT_STATUTORY_THRESHOLD=75.0
DEFAULT_WARNING_THRESHOLD=70.0
